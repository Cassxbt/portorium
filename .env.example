# SAMPLE_MODE=true runs the real gate on recorded Zetaris/Nightshift/NVIDIA responses, no credentials needed.
SAMPLE_MODE=false
# Copy to .env and fill in. Without these, Portorium runs in sample mode from recorded responses.
NVIDIA_API_KEY=
NIGHTSHIFT_URL=http://127.0.0.1:8088/v1
# Defaults to the token file Nightshift writes on macOS.
NIGHTSHIFT_TOKEN_FILE=
ZETARIS_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=1
